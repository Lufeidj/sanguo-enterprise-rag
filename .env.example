MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=default
MILVUS_COLLECTION=sanguo_chunks
EMBEDDING_DIM=1024

# Optional: chat model endpoint
LLM_BASE_URL=
LLM_API_KEY=
